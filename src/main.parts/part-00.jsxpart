async function rmsTechRpcWithFallback(rpcCall, fallbackCall, label = 'tech rpc') {
  try {
    return await rpcCall()
  } catch (err) {
    console.warn(`${label} failed, fallback used:`, err)
    if (typeof fallbackCall === 'function') return await fallbackCall(err)
    throw err
  }
}


