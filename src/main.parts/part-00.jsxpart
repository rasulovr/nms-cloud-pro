              </tbody>
            </table>
          </div>
        </section>
      )}


{preview && (
        <section className="card span-2">
          <div className="card-head">
            <div>
              <h3>Snapshot Preview</h3>
              <p className="hint">
                {preview.snapshot_type} · {String(preview.created_at || '').slice(0,19).replace('T',' ')}
