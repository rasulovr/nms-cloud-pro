  border-radius:14px;
  padding:10px 12px;
  font-size:13px;
  line-height:1.45;
}
.rms-pro-shell .tech-secure-rpc-step.is-ready{
  border-color:#bbf7d0;
  background:#ecfdf5;
}
.rms-pro-shell .tech-secure-rpc-step.is-waiting{
